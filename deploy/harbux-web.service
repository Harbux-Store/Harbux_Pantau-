[Unit]
Description=Harbux Web (Next.js)
After=network-online.target harbux-api.service
Wants=network-online.target

[Service]
Type=simple
User=harbux
Group=harbux
WorkingDirectory=/opt/harbux/web
Environment=NODE_ENV=production
Environment=PORT=3000
# Alamat API yang dipanggil Next.js (rewrite /api/* dan /auth/*)
Environment=API_ORIGIN=http://127.0.0.1:8080
ExecStart=/usr/bin/npm run start
Restart=always
RestartSec=3

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/harbux/web/.next

[Install]
WantedBy=multi-user.target
