# Konfigurasi web Harbux (Next.js).
# Untuk pengembangan lokal: salin jadi .env.local
# Untuk Vercel: isi sebagai Environment Variable di dashboard proyek.

# Alamat API Go. Next.js meneruskan /api/* dan /auth/* ke sini dari sisi server,
# sehingga browser tidak pernah menghubungi API secara langsung (cookie login
# tetap satu domain, dan CORS tidak diperlukan).
#
# Lokal   : http://localhost:8080
# Produksi: https://api.domain-kamu.com   <- wajib HTTPS
API_ORIGIN=http://localhost:8080
