# Contoh konfigurasi server Harbux. Salin jadi .env di server, lalu isi nilainya.
# JANGAN commit file .env yang asli.

# --- Database ---
# Diisi  -> MySQL/MariaDB (untuk server)
# Kosong -> SQLite di HARBUX_DB (untuk pengembangan di laptop)
HARBUX_DSN=harbux:GANTI_SANDI@tcp(127.0.0.1:3306)/harbux?parseTime=true&charset=utf8mb4&loc=Asia%2FJakarta
HARBUX_DB=data/cashflow.db

# --- Keamanan ---
# Kunci penanda-tangan login, minimal 32 karakter. Buat dengan:
#   openssl rand -base64 48
HARBUX_SECRET=GANTI_DENGAN_TEKS_ACAK_MINIMAL_32_KARAKTER

# Cookie login hanya dikirim lewat HTTPS.
# Isi 0 dulu saat HTTPS belum aktif, lalu ubah ke 1 setelah certbot berhasil
# dan restart API. Kalau diisi 1 sebelum HTTPS jalan, login akan selalu
# kembali ke halaman login tanpa pesan error.
HARBUX_SECURE_COOKIE=0

# Percayai header X-Forwarded-For untuk mengetahui IP asli pengunjung.
# Isi 1 HANYA bila API berada di belakang Nginx (sesuai panduan deploy).
# Kalau API bisa dihubungi langsung dari internet, biarkan 0 — kalau tidak,
# penyerang bisa mengarang IP dan lolos dari pembatasan percobaan login.
HARBUX_TRUST_PROXY=1

# --- Server ---
# Alamat dengar. Default 127.0.0.1:8080 -> hanya bisa dihubungi dari dalam
# server (lewat Nginx). Jangan ubah ke 0.0.0.0 kecuali kamu paham risikonya.
PORT=8080
# HARBUX_ADDR=127.0.0.1:8080
